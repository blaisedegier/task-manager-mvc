@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-5">Task Manager</h1>
    <p class="lead">Keep track of what needs doing: add a task with a title, an optional description and a deadline, then edit or remove it as plans change.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Task" asp-action="Index">View tasks</a>
    <a class="btn btn-outline-secondary btn-lg" asp-controller="Task" asp-action="Create">Add a task</a>
</div>
